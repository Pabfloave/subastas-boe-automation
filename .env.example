# WordPress REST API (publicación de posts)
WP_URL=https://comprarensubasta.com
WP_USER=
WP_APP_PASSWORD=
WP_POST_STATUS=publish
WP_CONTACT_FORM_URL=https://comprarensubasta.com/#analisis

# Google Maps Platform — Geocoding API + Maps Embed API.
# Obtener en: console.cloud.google.com → APIs & Services → Credentials.
# Activar: "Geocoding API" y "Maps Embed API". Restringir la key por IP o por API.
# Si se deja vacía, el publisher cae al iframe legacy con texto bruto.
GOOGLE_MAPS_API_KEY=

# Base de datos local (SQLite)
DB_PATH=data/subastas.db

# Scraper
SELENIUM_HEADLESS=true
REQUEST_TIMEOUT=30
DELAY_BETWEEN_REQUESTS=2
MAX_RETRIES=3
PAGE_LOAD_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# Provincias a sincronizar (códigos INE separados por coma, vacío = todas)
PROVINCIAS=
