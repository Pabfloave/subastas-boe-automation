# Entorno de staging (Docker WordPress local).
# Copiar a .env.staging y rellenar.

WP_URL=http://localhost:8080
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_POST_STATUS=publish
WP_CONTACT_FORM_URL=http://localhost:8080/#analisis

# BD separada para no contaminar la de producción
DB_PATH=./data/subastas-staging.db

# Scraping (mantén los defaults en staging)
SELENIUM_HEADLESS=true
REQUEST_TIMEOUT=30
DELAY_BETWEEN_REQUESTS=2
MAX_RETRIES=3
PAGE_LOAD_TIMEOUT=60

# Logging
LOG_LEVEL=DEBUG
LOG_MAX_SIZE_MB=10
LOG_BACKUP_COUNT=5

# En staging, solo 2-3 provincias para acelerar tests
PROVINCIAS=41,28,46
